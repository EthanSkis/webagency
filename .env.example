# Public site URL (absolute, no trailing slash).
# For GitHub Pages the workflow derives this automatically; only set it
# locally if you want sitemap.xml / OG tags to use a specific origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Subpath where the site is served. Leave empty for root hosting or
# custom domains; set to "/webagency" for GitHub project Pages.
# The workflow in .github/workflows/deploy.yml sets this automatically.
NEXT_PUBLIC_BASE_PATH=
