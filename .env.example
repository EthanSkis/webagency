# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Pixelcraft Agency"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webagency?schema=public"

# Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL=http://localhost:3000

# OAuth providers (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email - Resend (or fall back to SMTP)
RESEND_API_KEY=
EMAIL_FROM="hello@example.com"

# SMTP (used if RESEND_API_KEY is not set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Admin bootstrap (seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
